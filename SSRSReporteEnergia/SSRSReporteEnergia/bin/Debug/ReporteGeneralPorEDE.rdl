  <DataSources>
    <DataSource Name="DataSourceEnergia">
      <DataSourceReference>EnergiaSource</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>9af638e1-4fd8-406f-900d-98ed620487f6</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSetEnergiaGeneralPorEDE">
      <Query>
        <DataSourceName>DataSourceEnergia</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@IdEDE">
            <Value>=Parameters!IdEDE.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaInicio">
            <Value>=Parameters!FechaInicio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FechaFin">
            <Value>=Parameters!FechaFin.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select
s.Nombre,
convert(varchar,t.Fecha,103) Fecha, 
s.Direccion,
u.Provincia,
f.EnergiaEntregada_GWh, f.EnergiaPerdida_GWh
from FactEnergia as f
inner join DimSucursal as s on f.IdSucursal = s.IdSucursal
inner join DimTiempo as t on f.IdTiempo = t.IdTiempo
inner join DimUbicacion as u on f.IdUbicacion = u.IdUbicacion
where IdEDE = @IdEDE and t.Fecha between @FechaInicio and @FechaFin</CommandText>
      </Query>
      <Fields>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Fecha">
          <DataField>Fecha</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Direccion">
          <DataField>Direccion</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Provincia">
          <DataField>Provincia</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="EnergiaEntregada_GWh">
          <DataField>EnergiaEntregada_GWh</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="EnergiaPerdida_GWh">
          <DataField>EnergiaPerdida_GWh</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSetEDEs">
      <Query>
        <DataSourceName>DataSourceEnergia</DataSourceName>
        <CommandText>select IdEDE, Nombre from DimEDE</CommandText>
      </Query>
      <Fields>
        <Field Name="IdEDE">
          <DataField>IdEDE</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Nombre">
          <DataField>Nombre</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
