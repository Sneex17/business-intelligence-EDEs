  <MdxScripts>
    <MdxScript dwd:design-time-name="c441d679-a6f6-4990-8a02-6c207443cd1c">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T04:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T04:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/
CALCULATE;   
CREATE MEMBER CURRENTCUBE.[Measures].PorcentajeDePerdida
 AS [Measures].[Energia Perdida G Wh]/[Measures].[Energia Entregada G Wh], 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ;   
CREATE MEMBER CURRENTCUBE.[Measures].PorcentajeDeEntrega
 AS 1 - PorcentajeDePerdida, 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="a3ce5dc9-92e1-4ba3-9a9f-5ea96f10c614">
      <ID>KPI</ID>
      <Name>KPITasaDePerdida</Name>
      <Value>[Measures].[PorcentajeDePerdida]</Value>
      <Goal>0.12</Goal>
      <Status>Case
  When [Measures].[PorcentajeDePerdida] &lt;= 0.12 Then 1   
  When [Measures].[PorcentajeDePerdida] &lt;= 0.15 Then 0  
  Else -1
End</Status>
      <Trend>Case
  When [Measures].[PorcentajeDePerdida] &lt; ([Measures].[PorcentajeDePerdida], [DimTiempo].[Fecha].CurrentMember.PrevMember) Then 1
  When [Measures].[PorcentajeDePerdida] = ([Measures].[PorcentajeDePerdida], [DimTiempo].[Fecha].CurrentMember.PrevMember) Then 0   
  Else -1                                          
End</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="cff52db0-0d55-47c6-af1d-1b169d702b8d">
      <ID>KPI 1</ID>
      <Name>KPITasaDeEntreta</Name>
      <Value>[Measures].[PorcentajeDeEntrega]</Value>
      <Goal>0.88</Goal>
      <Status>Case
    When [Measures].[PorcentajeDeEntrega] &gt;= 0.88 Then 1
    When [Measures].[PorcentajeDeEntrega] &lt;= 0.879 and [Measures].[PorcentajeDeEntrega] &gt;= 0.85 Then 0
    Else -1
End</Status>
      <Trend>Case
  When [Measures].[PorcentajeDeEntrega] &gt; ([Measures].[PorcentajeDeEntrega], [DimTiempo].[Fecha].CurrentMember.PrevMember) Then 1
  When [Measures].[PorcentajeDeEntrega] = ([Measures].[PorcentajeDeEntrega], [DimTiempo].[Fecha].CurrentMember.PrevMember) Then 0   
  Else -1                                          
End</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
  </Kpis>
</Cube>