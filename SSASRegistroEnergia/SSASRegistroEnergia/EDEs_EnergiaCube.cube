  <MdxScripts>
    <MdxScript dwd:design-time-name="03661884-1502-4e80-b8f0-15a9264bbf14">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T04:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T04:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
El comando CALCULATE controla la agregación de celdas hoja en el cubo.
Si se elimina o modifica el comando CALCULATE, se ven afectados los datos del cubo.
Solo debe editar este comando si especifica manualmente cómo se agrega el cubo.
*/
CALCULATE;   
CREATE MEMBER CURRENTCUBE.[Measures].PorcentajeDePerdida
 AS [Measures].[Energia Perdida G Wh]/[Measures].[Energia Entregada G Wh], 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ;   
CREATE MEMBER CURRENTCUBE.[Measures].PorcentajeDeEntrega
 AS 1 - PorcentajeDePerdida, 
FORMAT_STRING = "Percent", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="dfdb44d1-4d3f-4afd-b584-043b0c6a4cb4">
      <ID>KPI</ID>
      <Name>KPITasaDePerdida</Name>
      <Value>[Measures].[PorcentajeDePerdida]</Value>
      <Goal>0.12</Goal>
      <Status>Case
  When [Measures].[PorcentajeDePerdida] &lt;= 0.12 Then 1   
  When [Measures].[PorcentajeDePerdida] &lt;= 0.15 Then 0  
  Else -1
End</Status>
      <Trend>Case
  /* Si el usuario está consultando a nivel de Fecha */
  When NOT IsEmpty([DimTiempo].[Fecha].CurrentMember) 
       And [DimTiempo].[Fecha].CurrentMember IS NOT [DimTiempo].[Fecha].[All] Then
    Case
      When IsEmpty(([Measures].[PorcentajeDePerdida], [DimTiempo].[Fecha].CurrentMember.PrevMember)) Then 0
      When [Measures].[PorcentajeDePerdida] &lt; ([Measures].[PorcentajeDePerdida], [DimTiempo].[Fecha].CurrentMember.PrevMember) Then 1
      When [Measures].[PorcentajeDePerdida] = ([Measures].[PorcentajeDePerdida], [DimTiempo].[Fecha].CurrentMember.PrevMember) Then 0
      Else -1
    End

  /* Si el usuario está consultando a nivel de Día */
  When NOT IsEmpty([DimTiempo].[JerarquiaDay].CurrentMember) 
       And [DimTiempo].[JerarquiaDay].CurrentMember IS NOT [DimTiempo].[JerarquiaDay].[All] Then
    Case
      When IsEmpty(([Measures].[PorcentajeDePerdida], [DimTiempo].[JerarquiaDay].CurrentMember.PrevMember)) Then 0
      When [Measures].[PorcentajeDePerdida] &lt; ([Measures].[PorcentajeDePerdida], [DimTiempo].[JerarquiaDay].CurrentMember.PrevMember) Then 1
      When [Measures].[PorcentajeDePerdida] = ([Measures].[PorcentajeDePerdida], [DimTiempo].[JerarquiaDay].CurrentMember.PrevMember) Then 0
      Else -1
    End

  /* Si el usuario está consultando a nivel de Mes */
  When NOT IsEmpty([DimTiempo].[JerarquiaMonth].CurrentMember) 
       And [DimTiempo].[JerarquiaMonth].CurrentMember IS NOT [DimTiempo].[JerarquiaMonth].[All] Then
    Case
      When IsEmpty(([Measures].[PorcentajeDePerdida], [DimTiempo].[JerarquiaMonth].CurrentMember.PrevMember)) Then 0
      When [Measures].[PorcentajeDePerdida] &lt; ([Measures].[PorcentajeDePerdida], [DimTiempo].[JerarquiaMonth].CurrentMember.PrevMember) Then 1
      When [Measures].[PorcentajeDePerdida] = ([Measures].[PorcentajeDePerdida], [DimTiempo].[JerarquiaMonth].CurrentMember.PrevMember) Then 0
      Else -1
    End

  /* Si el usuario está consultando a nivel de Trimestre */
  When NOT IsEmpty([DimTiempo].[JerarquiaTrimestre].CurrentMember) 
       And [DimTiempo].[JerarquiaTrimestre].CurrentMember IS NOT [DimTiempo].[JerarquiaTrimestre].[All] Then
    Case
      When IsEmpty(([Measures].[PorcentajeDePerdida], [DimTiempo].[JerarquiaTrimestre].CurrentMember.PrevMember)) Then 0
      When [Measures].[PorcentajeDePerdida] &lt; ([Measures].[PorcentajeDePerdida], [DimTiempo].[JerarquiaTrimestre].CurrentMember.PrevMember) Then 1
      When [Measures].[PorcentajeDePerdida] = ([Measures].[PorcentajeDePerdida], [DimTiempo].[JerarquiaTrimestre].CurrentMember.PrevMember) Then 0
      Else -1
    End

  /* Si el usuario está consultando a nivel de Año */
  When NOT IsEmpty([DimTiempo].[JerarquiaYear].CurrentMember) 
       And [DimTiempo].[JerarquiaYear].CurrentMember IS NOT [DimTiempo].[JerarquiaYear].[All] Then
    Case
      When IsEmpty(([Measures].[PorcentajeDePerdida], [DimTiempo].[JerarquiaYear].CurrentMember.PrevMember)) Then 0
      When [Measures].[PorcentajeDePerdida] &lt; ([Measures].[PorcentajeDePerdida], [DimTiempo].[JerarquiaYear].CurrentMember.PrevMember) Then 1
      When [Measures].[PorcentajeDePerdida] = ([Measures].[PorcentajeDePerdida], [DimTiempo].[JerarquiaYear].CurrentMember.PrevMember) Then 0
      Else -1
    End

  Else 0
End</Trend>
      <TrendGraphic>Smiley Face</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
