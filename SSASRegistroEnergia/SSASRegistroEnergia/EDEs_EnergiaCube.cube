                  <Source xsi:type="ColumnBinding" dwd:design-time-name="b986d050-fb18-4923-8529-0ba3fd2b57c5">
                    <TableID>dbo_FactEnergia</TableID>
                    <ColumnID>IdUbicacion</ColumnID>
                  </Source>
                </KeyColumn>
              </KeyColumns>
              <Type>Granularity</Type>
            </Attribute>
          </Attributes>
